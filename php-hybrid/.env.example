APP_NAME="Bangladesh Voter App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-service.onrender.com
APP_TIMEZONE=Asia/Dhaka
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Keep existing production values unchanged. Never commit actual secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

CORS_ALLOWED_ORIGINS=https://your-frontend.example
PDF_STORAGE_PATH=/var/data/pdfs
PYTHON_WORKER_URL=
PYTHON_WORKER_TOKEN=

# PDF storage: use s3 for separate Render services; pdf_local only for a truly shared mounted volume.
FILESYSTEM_DISK=s3
PDF_STORAGE_PATH=/var/data/pdfs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Queue worker: deploy a separate Render Background Worker from php-hybrid/Dockerfile.
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=1900
PYTHON_WORKER_URL=
PYTHON_WORKER_TOKEN=
PYTHON_WORKER_TIMEOUT=1500
PDF_MAX_FILE_MB=50
PDF_MAX_FILES_PER_UPLOAD=100
