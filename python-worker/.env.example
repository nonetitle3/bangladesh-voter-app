WORKER_API_TOKEN=replace-with-a-long-random-secret
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
SHARED_STORAGE_ROOT=/var/data
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10
PDF_TEXT_MIN_CHARS=25
OCR_LANGUAGES=ben+eng
OCR_DPI=220
OCR_TIMEOUT_SECONDS=120
MAX_PDF_MB=100

# Optional private S3-compatible object storage (recommended for separate Render services).
# Store documents.stored_path as s3://<bucket>/<object-key>.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
